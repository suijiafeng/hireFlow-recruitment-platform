# HireFlow - AI-Powered Recruitment Platform
# Web 入口：静态站点 + /api 反代。API_ORIGIN 由容器环境变量注入（nginx 官方镜像的
# /etc/nginx/templates 会在启动时对本文件做 envsubst，只替换实际存在的环境变量，
# 不会误伤 $host/$uri 等 nginx 内置变量）。
# docker-compose demo：API_ORIGIN=api:3000（默认值见 Dockerfile ENV）
# Render 付费档：API_ORIGIN=<api 服务 Internal Address>（控制台 Connect 面板可查，
#   注意内部主机名可能带随机后缀，不能想当然按服务名填）
# Render 免费档：API_ORIGIN=<api 服务公网 URL>（如 https://xxx.onrender.com——免费实例
#   休眠后只有公网流量能唤醒，走私网会一直 502）
# API_ORIGIN -> API_UPSTREAM 的协议归一化见 00-api-upstream.envsh
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # 简历/证件上传 ≤10MB，留余量
  client_max_body_size 20m;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # 上游必须请求期解析：写死主机名时 nginx 启动即解析一次，api 未就绪会直接退出
  # （host not found in upstream），且 Render 私网 IP 每次部署都变，旧 IP 会 502。
  # resolver 列表由镜像入口 15-local-resolvers.envsh 从 /etc/resolv.conf 生成，
  # 需 NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1（见 Dockerfile web stage）。
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  # 后端接口：保留 /api 前缀转发（api 服务已 setGlobalPrefix('api')）。
  # proxy_pass 带变量且不带 URI 时原样透传请求 URI，与写死主机名行为一致；
  # api 不可达仅 /api 返回 502，静态站点不受影响。
  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    # 不覆盖 Host：默认 $proxy_host 对私网无所谓，对 onrender.com 公网上游是必需
    # （Render 边缘按 Host 路由）；https 上游同理需要 SNI，对 http 上游无副作用
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # AI 生成类接口最长 60s + 重试，放宽读超时
    proxy_read_timeout 180s;
  }

  # 指纹化静态资源长缓存
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # SPA 路由回退（/portal/* 免登录直链、刷新任意路由）
  location / {
    try_files $uri $uri/ /index.html;
  }
}
