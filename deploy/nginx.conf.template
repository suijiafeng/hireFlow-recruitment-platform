# HireFlow - AI-Powered Recruitment Platform
# Web 入口：静态站点 + /api 反代。API_ORIGIN 由容器环境变量注入（nginx 官方镜像的
# /etc/nginx/templates 会在启动时对本文件做 envsubst，只替换实际存在的环境变量，
# 不会误伤 $host/$uri 等 nginx 内置变量）。
# docker-compose demo：API_ORIGIN=api:3000（默认值见下方 Dockerfile ENV）
# Render：API_ORIGIN=<api 服务名>:<内部端口>（同区域私有网络可达）
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # 简历/证件上传 ≤10MB，留余量
  client_max_body_size 20m;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # 后端接口：保留 /api 前缀转发（api 服务已 setGlobalPrefix('api')）
  location /api/ {
    proxy_pass http://${API_ORIGIN};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # AI 生成类接口最长 60s + 重试，放宽读超时
    proxy_read_timeout 180s;
  }

  # 指纹化静态资源长缓存
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # SPA 路由回退（/portal/* 免登录直链、刷新任意路由）
  location / {
    try_files $uri $uri/ /index.html;
  }
}
