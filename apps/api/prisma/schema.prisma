// HireFlow 数据模型（枚举与 packages/shared/src/enums.ts 保持同步，schema 是事实来源）

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DataScope {
  ALL
  DEPARTMENT
  OWN
  ASSIGNED
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  WITHDRAWN
  HIRED
}

enum ResumeParseStatus {
  PENDING
  PARSING
  DONE
  FAILED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  status       UserStatus  @default(ACTIVE)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  roles        UserRole[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  activityLogs      ActivityLog[]
  hiringManagerJobs Job[]         @relation("JobHiringManager")
  createdJobs       Job[]         @relation("JobCreatedBy")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  dataScope   DataScope        @default(ASSIGNED)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id       String       @id @default(cuid())
  name     String
  parentId String?
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  users    User[]
  jobs     Job[]
}

model Job {
  id              String     @id @default(cuid())
  title           String
  description     String?
  requirement     String?
  headcount       Int        @default(1)
  status          JobStatus  @default(DRAFT)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  hiringManagerId String?
  hiringManager   User?      @relation("JobHiringManager", fields: [hiringManagerId], references: [id])
  createdById     String
  createdBy       User       @relation("JobCreatedBy", fields: [createdById], references: [id])
  stages          PipelineStage[]
  applications    Application[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// 每个职位可自定义的招聘阶段（Pipeline Builder）
model PipelineStage {
  id           String        @id @default(cuid())
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  applications Application[]

  @@index([jobId])
}

model Candidate {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  source       String? // 来源渠道
  tags         String[] // AI/人工标签
  profile      Json? // 结构化画像扩展
  resumes      Resume[]
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Resume {
  id          String            @id @default(cuid())
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileKey     String? // 对象存储 key（文件上传后续接入）
  fileName    String?
  rawText     String?
  parsed      Json? // AI 解析后的结构化 JSON（二期）
  skills      String[]
  parseStatus ResumeParseStatus @default(PENDING)
  createdAt   DateTime          @default(now())
}

// 应聘记录：连接 Candidate 与 Job，驱动 Pipeline
model Application {
  id          String            @id @default(cuid())
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id])
  stageId     String
  stage       PipelineStage     @relation(fields: [stageId], references: [id])
  status      ApplicationStatus @default(ACTIVE)
  matchScore  Int? // AI 匹配度分数（二期）
  matchReport Json? // 打分依据（二期）
  position    Float             @default(0) // 看板列内排序
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([candidateId, jobId])
  @@index([jobId, stageId])
}

// 全流程操作日志：360° 时间轴 + 合规审计
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorName  String? // 冗余存储：候选人/系统触发时无内部用户
  action     String // 约定见 shared ACTIVITY_ACTIONS，如 application.stage_changed
  entityType String // 取值如 Job / Candidate / Application / Interview
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
