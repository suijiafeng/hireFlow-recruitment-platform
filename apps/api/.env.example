# PostgreSQL 连接（与根目录 docker-compose.yml 对应）
DATABASE_URL="postgresql://arthr:arthr_dev_password@localhost:5432/arthr?schema=public"

# JWT 签名密钥（生产环境务必更换为强随机值）
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# ── AI 网关（模型可插拔）──────────────────────────────
# 留空则使用内置规则引擎（mock）兜底，全链路仍可用
ANTHROPIC_API_KEY=""
# 默认模型；成本敏感场景可换 claude-haiku-4-5
ANTHROPIC_MODEL="claude-opus-4-8"
# 私有化/网关部署时覆盖（可选）
ANTHROPIC_BASE_URL=""
# auto | mock | anthropic（auto：有 key 用 LLM，否则 mock）
AI_PROVIDER="auto"

# 服务端口
PORT=3000
