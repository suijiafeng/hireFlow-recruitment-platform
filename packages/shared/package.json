{
  "name": "@hireflow/shared",
  "version": "0.1.0",
  "private": true,
  "description": "HireFlow 前后端共享的枚举、权限码与常量（CJS + ESM 双产物）",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "dev": "concurrently -n shared-cjs,shared-esm \"tsc -w -p tsconfig.cjs.json --preserveWatchOutput\" \"tsc -w -p tsconfig.esm.json --preserveWatchOutput\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
